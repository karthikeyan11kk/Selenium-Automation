<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-surefire-plugin</artifactId>
    <version>3.0.0-M9</version>
    <configuration>
        <!-- was "SuiteICE.xml" in the original pom, which didn't exist in the
             repo (only SuiteNIG.xml did) - pointed at the new Cucumber-TestNG
             wiring in testng.xml instead. -->
        <suiteXmlFiles>
            <suiteXmlFile>testng.xml</suiteXmlFile>
        </suiteXmlFiles>
        <systemPropertyVariables>
						<javax.net.ssl.trustStore>
							C:\Users\P00962\New-eclipse-workspace\Intact-BDD\Certs\cacerts</javax.net.ssl.trustStore>
						<javax.net.ssl.trustStorePassword>changeit</javax.net.ssl.trustStorePassword>
		</systemPropertyVariables>
    </configuration>
</plugin>

<!-- exec-maven-plugin: lets the pipeline run the Feature 1 upload UI with a
     single command before "mvn test", without needing a separate runnable
     jar: mvn -q compile exec:java@upload-ui  (see README.md "Feature 1"). -->
<plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>exec-maven-plugin</artifactId>
    <version>3.1.0</version>
    <executions>
        <execution>
            <id>upload-ui</id>
            <!-- no <phase> set deliberately - only runs when explicitly
                 invoked as exec:java@upload-ui, never during a normal
                 mvn test/build lifecycle. -->
            <goals>
                <goal>java</goal>
            </goals>
            <configuration>
                <mainClass>utils.TestDataUploadServer</mainClass>
            </configuration>
        </execution>
    </executions>
</plugin>

            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>20</release>
                    <!-- Nothing in this project uses Lombok, but some
                         Lombok jar was getting picked up as an annotation
                         processor and failing against newer JDKs' module
                         system (JavacProcessingEnvironment access error).
                         -proc:none disables annotation processing outright,
                         which this project doesn't need anyway. -->
                    <compilerArgs>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
